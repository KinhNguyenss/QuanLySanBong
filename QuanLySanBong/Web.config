<?xml version="1.0" encoding="utf-8"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  https://go.microsoft.com/fwlink/?LinkId=301880
  -->
<configuration>
	<!--
	conection to database sql server with 
	• Data Source: Trỏ đến Server (DESKTOP-4GMB9AI\SQLEXPRESS).
    • Initial Catalog: tên database QuanLySanBong .
    • Integrated Security=True: Chế độ đăng nhập bằng tài khoản Windows không mật khẩu.
	nếu có mật khẩu thì thay Integrated Security=True bằng User ID=sa;Password=123456
	 connectionString="Data Source=DESKTOP-4GMB9AI\SQLEXPRESS;Initial Catalog=QuanLySanBong;User ID=id_đã_đặt;Password=Mật_Khẩu;TrustServerCertificate=True"
	-->
	<connectionStrings>
		<add name="DbSanBong"
			 connectionString="Data Source=DESKTOP-4GMB9AI\SQLEXPRESS;Initial Catalog=QuanLySanBong;Integrated Security=True;TrustServerCertificate=True"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>
  <appSettings>
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" />
  </system.web>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Antlr3.Runtime" publicKeyToken="eb42632606e9261f" />
